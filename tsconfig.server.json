{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "es2022",
    "lib": [
      "ES2023"
    ],
    "skipLibCheck": true,
    "module": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "outDir": "dist-server",
    "rootDir": "server",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "node"
    ],
    "moduleResolution": "nodenext"
  },
  "include": [
    "server"
  ],
  "exclude": [
    "server/__tests__"
  ]
}
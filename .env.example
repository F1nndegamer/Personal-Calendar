# Magister iCalendar feed configuration (example — placeholders only!)
#
# Copy this file to `.env.local` (git-ignored) and paste your own feed URL.
# Your feed URL is private: NEVER commit it, log it, or share it.
#
# In Magister: Agenda → Instellingen → iCalendar feed, then copy the
# subscription link. It looks like:
#   webcal://calendar.magister.net/api/icalendar/feeds/YOUR-FEED-ID

VITE_MAGISTER_FEED_URL=webcal://calendar.magister.net/api/icalendar/feeds/YOUR-FEED-ID

# Server-side proxy for the feed. In development: run the Node proxy
# (see server/) alongside Vite. In production: Nginx proxies /ics to the
# proxy on 127.0.0.1:3000, so the frontend uses the same-origin path.
#
# Development (two servers):
#   VITE_SCHEDULE_PROXY_URL=http://localhost:5173/ics
#
# Production (same origin via Nginx):
#   VITE_SCHEDULE_PROXY_URL=/ics


# ---------------------------------------------------------------------------
# Google Calendar integration (server-side OAuth) — placeholders only!
#
# Create these in Google Cloud Console (full walkthrough in DEPLOY.md §9):
#   1. Create a project and enable the "Google Calendar API".
#   2. OAuth consent screen → External → add yourself as a test user.
#   3. Credentials → Create credentials → OAuth client ID → Web application.
#      Authorized redirect URIs (exact, no trailing slash):
#        development:  http://localhost:5173/api/google/callback
#        production:   https://calendar.f1nn.me/api/google/callback
#
# The SERVER (not Vite) reads these three — export them when starting
# dist-server/server.js, or put them in the server's .env / systemd
# EnvironmentFile. When all three are missing, /api/google/* answers with
# "not configured" and the Settings UI simply shows Google as unavailable.
#
# GOOGLE_CLIENT_ID=YOUR-CLIENT-ID.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=YOUR-CLIENT-SECRET
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
#
# Optional: where OAuth tokens are written (mode 0600, never logged, never
# returned by /api/storage). Defaults to the STORAGE_PATH directory.
# GOOGLE_AUTH_PATH=./data/google-auth.json

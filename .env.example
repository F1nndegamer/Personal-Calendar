# Magister iCalendar feed configuration (example — placeholders only!)
#
# Copy this file to `.env.local` (git-ignored) and paste your own feed URL.
# Your feed URL is private: NEVER commit it, log it, or share it.
#
# In Magister: Agenda → Instellingen → iCalendar feed, then copy the
# subscription link. It looks like:
#   webcal://calendar.magister.net/api/icalendar/feeds/YOUR-FEED-ID

VITE_MAGISTER_FEED_URL=webcal://calendar.magister.net/api/icalendar/feeds/YOUR-FEED-ID

# Server-side proxy for the feed. In development: run the Node proxy
# (see server/) alongside Vite. In production: Nginx proxies /ics to the
# proxy on 127.0.0.1:3000, so the frontend uses the same-origin path.
#
# Development (two servers):
#   VITE_SCHEDULE_PROXY_URL=http://localhost:5173/ics
#
# Production (same origin via Nginx):
#   VITE_SCHEDULE_PROXY_URL=/ics
